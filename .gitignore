/bin/

# Python
__pycache__/
*.pyc
.venv/

# Misc
.DS_Store
*.log

# Next.js
.next/
apps/**/.next/
*.tsbuildinfo
.vercel

# Playwright (keep __screenshots__ baselines; ignore run artifacts)
test-results/
playwright-report/
apps/web/test-results/
apps/web/playwright-report/
