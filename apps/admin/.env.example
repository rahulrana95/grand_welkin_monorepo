# WelkinBliss admin — copy to .env.local and fill in. NEVER commit real secrets.
# Without these the app runs on mock auth + an in-memory repo (visual tests use this).

# Supabase (the shared backend). Provisions Supabase Auth + the welkin_bliss_* repo.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — keep it out of the browser and out of git.
SUPABASE_SERVICE_ROLE_KEY=

# Mock-auth allowlist (used only when Supabase is NOT configured).
ADMIN_EMAILS=admin@welkinbliss.com
