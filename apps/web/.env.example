# WelkinBliss web — copy to .env.local and fill in. NEVER commit real secrets.
# Everything is optional: without it the site uses mock data / mock availability.

# Supabase (shared backend) — read admin blocked dates + per-date price overrides
# and merge them into the public availability calendar.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only (route handlers). Bypasses RLS — keep out of the browser and git.
SUPABASE_SERVICE_ROLE_KEY=

# Availability source. Set to "uplisting" with a key to use the real PMS calendar.
AVAILABILITY_SOURCE=
UPLISTING_API_KEY=
# UPLISTING_BASE_URL=https://connect.uplisting.io

# On-demand cache revalidation (/api/revalidate). Shared secret the admin app sends
# after a site-copy edit so changes appear immediately. Leave unset to disable (the
# 5-minute cache TTL still refreshes copy).
REVALIDATE_SECRET=
