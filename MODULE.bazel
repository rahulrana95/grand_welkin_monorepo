"""
Bzlmod module definition for the polyglot monorepo.

Languages share ONE dependency graph so a change to a `.proto` (the single
source of truth) rebuilds and retests exactly the affected TS/Go/Python/Java
targets — nothing more. See docs/adr/0001-monorepo-build-system.md.

NOTE: version pins below are illustrative and recent-as-of-authoring. Confirm
each against the Bazel Central Registry (registry.bazel.build) and run
`bazel mod tidy` before relying on this. Treat this file as a starting point.
"""

module(
    name = "grand_welkin",
    version = "0.0.0",
)

# ---------------------------------------------------------------------------
# Protobuf — the single source of truth toolchain
# ---------------------------------------------------------------------------
bazel_dep(name = "protobuf", version = "29.3", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_buf", version = "0.3.0")  # buf lint / buf breaking as Bazel tests

# ---------------------------------------------------------------------------
# JavaScript / TypeScript — Aspect rulesets (modern replacement for rules_nodejs)
# ---------------------------------------------------------------------------
bazel_dep(name = "aspect_rules_js", version = "2.1.0")
bazel_dep(name = "aspect_rules_ts", version = "3.5.0")
bazel_dep(name = "aspect_rules_swc", version = "2.3.0")  # fast transpile; tsc still typechecks

# npm/pnpm dependencies translated from the lockfile
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")

# TypeScript compiler toolchain (tsc version resolved from package.json)
rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext", dev_dependency = True)
rules_ts_ext.deps()
use_repo(rules_ts_ext, "npm_typescript")

# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
bazel_dep(name = "rules_go", version = "0.51.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.40.0")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.4")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
# use_repo(go_deps, ...)  # `bazel mod tidy` fills this in from go.mod

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
bazel_dep(name = "rules_python", version = "1.0.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12", is_default = True)

# ---------------------------------------------------------------------------
# Java (java_proto_library is provided by protobuf/Bazel; rules_java for libs/apps)
# ---------------------------------------------------------------------------
bazel_dep(name = "rules_java", version = "8.6.1")
